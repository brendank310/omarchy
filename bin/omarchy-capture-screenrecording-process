#!/bin/bash

# omarchy:summary=Check or signal the current user's recording processes
# omarchy:args=[--pid <pid>] [--signal INT|KILL]
# omarchy:hidden=true

usage() {
  echo "Usage: omarchy-capture-screenrecording-process [--pid <pid>]... [--signal INT|KILL]" >&2
  exit 2
}

proc_root=${OMARCHY_PROC_ROOT:-/proc}
wanted=" "
signal=""

while (($#)); do
  case $1 in
    --pid)
      # Compare textually first: bash arithmetic wraps values past 64 bits.
      [[ ${2-} =~ ^0*([0-9]+)$ ]] || usage
      pid=${BASH_REMATCH[1]}
      ((${#pid} <= 10 && 10#$pid <= 4194304)) || usage
      wanted+="$((10#$pid)) "
      shift 2
      ;;
    --signal)
      [[ ${2-} == "INT" || ${2-} == "KILL" ]] || usage
      signal=$2
      shift 2
      ;;
    *)
      usage
      ;;
  esac
done

is_recorder() {
  local exe
  exe=$(readlink "$proc_root/$1/exe" 2>/dev/null) || return 1
  # Linux appends this when an upgrade unlinks a still-running executable.
  exe=${exe% (deleted)}
  exe=${exe##*/}
  [[ $exe == "gpu-screen-recorder" || $exe == "wf-recorder" ]]
}

# Linux truncates a process name to 15 characters: gpu-screen-recorder runs as
# gpu-screen-reco, which any executable sharing that prefix also matches, and a
# process can rename itself, so the executable path confirms each candidate.
matched=()
while read -r pid; do
  if [[ $wanted == " " || $wanted == *" $pid "* ]] && is_recorder "$pid"; then
    matched+=("$pid")
  fi
done < <(pgrep -u "$UID" -x 'gpu-screen-reco(rder)?|wf-recorder')

if ((${#matched[@]} == 0)); then
  exit 1
fi

# Open a pidfd before re-checking the executable, so a pid reused after the
# scan cannot receive the signal. Without pidfd, re-check and kill, which only
# narrows that window. Identity is read from proc_root (tests substitute it);
# the pidfd is always the live process.
signal_recorder() {
  local pid=$1 status=0

  python3 - "$pid" "$signal" "$proc_root" <<'PY'
import os
import signal
import sys
from pathlib import Path

pid = int(sys.argv[1])
signum = getattr(signal, "SIG" + sys.argv[2])
proc = Path(sys.argv[3]) / str(pid)
recorders = {"gpu-screen-recorder", "wf-recorder"}
try:
    fd = os.pidfd_open(pid)
except AttributeError:
    sys.exit(2)
except OSError:
    sys.exit(1)
try:
    if os.stat(proc).st_uid != os.geteuid():
        sys.exit(1)
    exe = os.readlink(proc / "exe")
    exe = exe.removesuffix(" (deleted)")
    if Path(exe).name not in recorders:
        sys.exit(1)
    signal.pidfd_send_signal(fd, signum)
except OSError:
    sys.exit(1)
finally:
    os.close(fd)
PY
  status=$?
  if (( status == 2 || status == 127 )); then
    is_recorder "$pid" && kill "-$signal" "$pid" 2>/dev/null
    return
  fi
  (( status == 0 ))
}

if [[ -n $signal ]]; then
  delivered=0
  for pid in "${matched[@]}"; do
    if signal_recorder "$pid"; then
      delivered=1
    fi
  done
  # A recorder that exits before its signal has stopped anyway; fail only if none was signalled.
  ((delivered)) || exit 1
fi

exit 0
