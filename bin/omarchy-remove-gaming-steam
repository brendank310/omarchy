#!/bin/bash

# omarchy:summary=Remove Steam and all of its game libraries, configs, and caches.
# omarchy:requires-sudo=true

set -e

# The platform hook removes launcher files the Mac package owns. Dropping the
# packages stays here so Steam and omarchy-steam-fex go together even when that
# hook is absent, and a host that cannot name its platform still finishes removal.
omarchy-lifecycle-dispatch pre-remove steam || true
omarchy-pkg-drop omarchy-steam-fex steam

desktop="$HOME/.local/share/applications/steam.desktop"
if [[ -f $desktop ]] && grep -q 'omarchy-launch-steam' "$desktop"; then
  rm -f "$desktop"
fi

rm -rf \
  "$HOME/.steam" \
  "$HOME/.local/share/Steam" \
  "$HOME/.local/share/fex-steam" \
  "$HOME/.config/steam" \
  "$HOME/.cache/steam"

echo ""
echo "Steam and its data have been removed."
