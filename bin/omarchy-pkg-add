#!/bin/bash

# omarchy:summary=Install Arch packages if they are missing
# omarchy:args=<packages...>
# omarchy:examples=omarchy pkg add jq ripgrep
# omarchy:requires-sudo=true

packages=("$@")
# aarch64 repos do not carry every x86-only package migrations ask for. Skip
# those with a warning so one missing name does not fail the migration. x86
# still fails closed, because a missing package there is a real error.
if ! omarchy-hw-x86; then
  available=()
  for pkg in "${packages[@]}"; do
    if pacman -Q -- "$pkg" &>/dev/null || pacman -Si -- "$pkg" &>/dev/null; then
      available+=("$pkg")
    else
      echo -e "\033[33mSkipping '$pkg': not available in the repos on this system\033[0m" >&2
    fi
  done
  (( ${#available[@]} )) || exit 0
  packages=("${available[@]}")
fi

if omarchy-pkg-missing "${packages[@]}"; then
  if (( EUID == 0 )); then
    pacman -S --noconfirm --needed -- "${packages[@]}" || exit 1
  else
    sudo pacman -S --noconfirm --needed -- "${packages[@]}" || exit 1
  fi
fi

for pkg in "${packages[@]}"; do
  # Secondary check to handle states where pacman doesn't actually register an error
  if ! pacman -Q -- "$pkg" &>/dev/null; then
    echo -e "\033[31mError: Package '$pkg' did not install\033[0m" >&2
    exit 1
  fi
done

exit 0
