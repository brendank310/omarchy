#!/bin/bash

# omarchy:summary=Install Steam and graphics drivers selected for this system
# omarchy:requires-sudo=true

set -e

architecture=$(uname -m)
if [[ $architecture == "aarch64" ]] && ! omarchy-pkg-present omarchy-steam-fex && ! omarchy-pkg-available omarchy-steam-fex; then
  echo "Steam launcher package omarchy-steam-fex is unavailable" >&2
  exit 1
fi

echo "Installing Steam..."

# Install the lib32 drivers first. Steam depends on the virtual package
# lib32-vulkan-driver, and omarchy-pkg-add runs pacman with --noconfirm, which
# resolves an unsatisfied virtual dependency to the first provider without
# asking. That provider is currently lib32-nvidia-utils, so installing Steam
# ahead of the drivers pulls the NVIDIA stack onto machines that have no NVIDIA
# GPU.
omarchy-install-gaming-gpu-lib32
omarchy-pkg-add steam
omarchy-lifecycle-dispatch post-install steam

if [[ $architecture == "aarch64" ]]; then
  omarchy-pkg-add omarchy-steam-fex
  if ! omarchy-pkg-present omarchy-steam-fex; then
    echo "Steam launcher package omarchy-steam-fex is unavailable" >&2
    exit 1
  fi
  omarchy-launch-steam --prepare
fi

echo ""
echo "Steam will start automatically now. This might take a while..."

setsid uwsm-app -- gtk-launch steam >/dev/null 2>&1 &
